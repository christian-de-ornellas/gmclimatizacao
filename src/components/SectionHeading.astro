---
interface Props {
  title: string;
  subtitle?: string;
  light?: boolean;
}

const { title, subtitle, light = false } = Astro.props;
---

<div class="text-center mb-12">
  <h2 class:list={[
    "font-heading text-3xl md:text-4xl font-bold mb-4",
    light ? "text-white" : "text-navy-900"
  ]}>
    {title}
  </h2>
  {subtitle && (
    <p class:list={[
      "max-w-2xl mx-auto text-lg",
      light ? "text-gray-300" : "text-gray-600"
    ]}>
      {subtitle}
    </p>
  )}
  <div class="w-16 h-1 bg-orange-500 mx-auto mt-4 rounded-full"></div>
</div>
