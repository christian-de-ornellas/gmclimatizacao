---
interface Props {
  title: string;
  subtitle?: string;
  light?: boolean;
}

const { title, subtitle, light = false } = Astro.props;
---

<div class="sr text-center mb-10 sm:mb-16">
  <h2 class:list={[
    "font-heading text-2xl sm:text-3xl md:text-4xl font-bold mb-3 sm:mb-4 tracking-tight",
    light ? "text-white" : "text-navy-900"
  ]}>
    {title}
  </h2>
  {subtitle && (
    <p class:list={[
      "max-w-2xl mx-auto text-base sm:text-lg",
      light ? "text-gray-400" : "text-gray-500"
    ]}>
      {subtitle}
    </p>
  )}
</div>
