---
import SectionHeading from "./SectionHeading.astro";

const differentials = [
  {
    icon: '<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" /></svg>',
    title: "Tecnicos das fabricantes",
    description: "Nossa equipe possui certificacao direta de Daikin, LG, Samsung e Carrier. Isso significa acesso a treinamentos exclusivos e dominio tecnico que vai alem do basico.",
  },
  {
    icon: '<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>',
    title: "Orcamento em ate 24h",
    description: "Voce envia as informacoes, nos respondemos com uma proposta detalhada. Sem enrolacao, sem visita desnecessaria para casos simples.",
  },
  {
    icon: '<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>',
    title: "Garantia documentada",
    description: "Entregamos termo de garantia em cada servico com prazos, cobertura e condicoes claras. Sem letras miudas, sem ambiguidade.",
  },
  {
    icon: '<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" /></svg>',
    title: "Orcamento sem surpresas",
    description: "O valor do orcamento e o valor da nota. Detalhamos materiais, mao de obra e prazos antes de iniciar — voce aprova sabendo exatamente o que esta pagando.",
  },
  {
    icon: '<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3H21m-3.75 3H21" /></svg>',
    title: "Do quarto ao andar inteiro",
    description: "Climatizamos desde um unico comodo ate edificios corporativos completos. A mesma exigencia tecnica em qualquer escala de projeto.",
  },
  {
    icon: '<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" /></svg>',
    title: "Relacionamento continuo",
    description: "Apos a entrega, voce continua tendo acesso direto ao nosso time tecnico. Duvidas, ajustes e manutencoes futuras — estamos a uma mensagem de distancia.",
  },
];
---

<section id="diferenciais" class="py-20 md:py-28 bg-gradient-to-br from-navy-900 to-navy-700">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="O que nos separa do improviso"
      subtitle="Climatizacao e engenharia, nao gambiarra. Veja como trabalhamos."
      light
    />

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {differentials.map((item) => (
        <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors duration-300">
          <div class="text-orange-500 mb-4">
            <Fragment set:html={item.icon} />
          </div>
          <h3 class="font-heading text-lg font-bold text-white mb-2">{item.title}</h3>
          <p class="text-gray-400 text-sm leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
