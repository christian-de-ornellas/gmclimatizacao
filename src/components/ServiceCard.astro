---
interface Props {
  icon: string;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---

<div class="group bg-white rounded-xl p-7 shadow-[0_1px_3px_rgba(0,0,0,0.04)] border border-gray-100 hover:shadow-[0_8px_30px_rgba(0,0,0,0.08)] hover:border-gold-500/30 transition-all duration-500">
  <div class="w-12 h-12 bg-gold-500/[0.08] rounded-lg flex items-center justify-center mb-4 text-gold-500 group-hover:bg-gold-500/15 transition-colors duration-500">
    <Fragment set:html={icon} />
  </div>
  <h3 class="font-heading text-lg font-bold text-navy-900 mb-2">{title}</h3>
  <p class="text-gray-600 text-sm leading-relaxed">{description}</p>
</div>
