---
interface Props {
  icon: string;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---

<div class="group bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:-translate-y-1 hover:shadow-lg hover:border-b-4 hover:border-b-orange-500 transition-all duration-300">
  <div class="w-14 h-14 bg-orange-500/10 rounded-xl flex items-center justify-center mb-4 text-orange-500 group-hover:bg-orange-500 group-hover:text-white transition-colors duration-300">
    <Fragment set:html={icon} />
  </div>
  <h3 class="font-heading text-lg font-bold text-navy-900 mb-2">{title}</h3>
  <p class="text-gray-600 text-sm leading-relaxed">{description}</p>
</div>
