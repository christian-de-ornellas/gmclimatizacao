---
import SectionHeading from "./SectionHeading.astro";
---

<section id="contato" class="py-16 sm:py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="Fale com a nossa equipe"
      subtitle="Resposta em até 24 horas. Sem compromisso, sem burocracia."
    />

    <div class="grid md:grid-cols-2 gap-12 lg:gap-16">
      <!-- Contact info -->
      <div class="sr space-y-6">
        <div class="flex items-start gap-4">
          <div class="w-11 h-11 bg-gold-500/[0.08] rounded-lg flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-gold-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
          </div>
          <div>
            <h3 class="font-heading font-semibold text-navy-900 mb-1">Telefone</h3>
            <a href="tel:+5521966917054" class="text-gray-600 hover:text-gold-600 transition-colors">(21) 96691-7054</a>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-11 h-11 bg-gold-500/[0.08] rounded-lg flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-gold-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
          </div>
          <div>
            <h3 class="font-heading font-semibold text-navy-900 mb-1">E-mail</h3>
            <a href="mailto:contato@gmclimatizacao.com.br" class="text-gray-600 hover:text-gold-600 transition-colors break-all sm:break-normal">contato@gmclimatizacao.com.br</a>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-11 h-11 bg-gold-500/[0.08] rounded-lg flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-gold-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
          </div>
          <div>
            <h3 class="font-heading font-semibold text-navy-900 mb-1">Endereço</h3>
            <p class="text-gray-600">Rio de Janeiro - RJ</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-11 h-11 bg-gold-500/[0.08] rounded-lg flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-gold-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <div>
            <h3 class="font-heading font-semibold text-navy-900 mb-1">Horário de Atendimento</h3>
            <p class="text-gray-600">Segunda a Sexta: 08h - 18h</p>
            <p class="text-gray-600">Sábado: 08h - 12h</p>
          </div>
        </div>

        <!-- Big WhatsApp CTA -->
        <a
          href="https://wa.me/5521966917054"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 w-full inline-flex items-center justify-center gap-2 sm:gap-3 bg-whatsapp text-white px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl text-base sm:text-lg font-semibold hover:brightness-110 transition-all shadow-[0_12px_40px_rgba(37,211,102,0.2)]"
        >
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Solicitar orçamento pelo WhatsApp
        </a>
      </div>

      <!-- Map -->
      <div class="sr aspect-square md:aspect-auto md:h-full min-h-[300px] rounded-xl overflow-hidden">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d470400.3976220498!2d-43.7228843!3d-22.9068467!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9bde559108a05b%3A0x50dc426c672fd24e!2sRio%20de%20Janeiro%2C%20RJ!5e0!3m2!1spt-BR!2sbr!4v1696000000000"
          width="100%"
          height="100%"
          style="border:0; min-height:300px;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Localização GM Climatização - Rio de Janeiro"
        ></iframe>
      </div>
    </div>
  </div>
</section>
