---
import SectionHeading from "./SectionHeading.astro";

interface Props {
  projects?: { title: string; gradient: string }[];
  headingTitle?: string;
  headingSubtitle?: string;
}

const {
  projects = [
    { title: "Apartamento Alto Padrão", gradient: "from-navy-700 to-navy-500" },
    { title: "Andar Corporativo", gradient: "from-navy-900 to-navy-700" },
    { title: "Loja em Shopping", gradient: "from-navy-500 to-gold-600" },
    { title: "Clínica Odontológica", gradient: "from-navy-700 to-navy-900" },
    { title: "Restaurante Gourmet", gradient: "from-gold-600 to-navy-700" },
    { title: "Coworking", gradient: "from-navy-900 to-navy-500" },
  ],
  headingTitle = "Projetos entregues",
  headingSubtitle = "Ambientes onde a climatização foi projetada, instalada e validada pela nossa equipe.",
} = Astro.props;
---

<section id="galeria" class="py-16 sm:py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title={headingTitle}
      subtitle={headingSubtitle}
    />

    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4 md:gap-6">
      {projects.map((project, i) => (
        <div class={`sr sr-delay-${i + 1} group relative aspect-[4/3] rounded-lg overflow-hidden cursor-pointer`}>
          <div class={`absolute inset-0 bg-gradient-to-br ${project.gradient}`}></div>
          <div class="absolute inset-0 flex items-center justify-center bg-black/30 group-hover:bg-black/50 transition-colors duration-500">
            <div class="text-center transform group-hover:scale-[1.02] transition-transform duration-500">
              <svg class="w-10 h-10 text-white/60 mx-auto mb-2" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" /></svg>
              <span class="text-white font-heading font-semibold text-sm md:text-base">{project.title}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
