---
const brands = [
  "Daikin", "LG", "Samsung", "Carrier", "Midea", "Gree", "Elgin", "Fujitsu", "Consul"
];
---

<section class="py-16 bg-surface overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
    <p class="text-center text-gray-500 text-sm font-medium uppercase tracking-wider">Certificados e autorizados pelas principais fabricantes</p>
  </div>

  <div class="relative">
    <!-- Fade edges -->
    <div class="absolute left-0 top-0 bottom-0 w-20 bg-gradient-to-r from-surface to-transparent z-10"></div>
    <div class="absolute right-0 top-0 bottom-0 w-20 bg-gradient-to-l from-surface to-transparent z-10"></div>

    <div class="flex" style="animation: marquee 30s linear infinite; width: max-content;">
      {[...brands, ...brands].map((brand) => (
        <div class="flex-shrink-0 mx-8 md:mx-12 flex items-center justify-center h-16 grayscale hover:grayscale-0 opacity-60 hover:opacity-100 transition-all duration-300">
          <span class="font-heading text-2xl md:text-3xl font-bold text-navy-700 select-none">{brand}</span>
        </div>
      ))}
    </div>
  </div>
</section>
