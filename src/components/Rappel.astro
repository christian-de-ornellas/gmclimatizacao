---
---

<section id="rapel" class="py-24 md:py-32 bg-gradient-to-br from-navy-950 via-navy-900 to-navy-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Animated rappelling illustration -->
      <div class="sr relative">
        <div class="aspect-[4/3] rounded-lg bg-gradient-to-b from-sky-900/40 via-navy-800 to-navy-900 overflow-hidden border border-white/5 rappel-scene">
          <svg viewBox="0 0 400 300" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
            <!-- Sky gradient background -->
            <defs>
              <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#0c1929" />
                <stop offset="100%" stop-color="#162a4a" />
              </linearGradient>
              <linearGradient id="buildingGrad" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#1e3a5f" />
                <stop offset="100%" stop-color="#1a2f4d" />
              </linearGradient>
              <linearGradient id="buildingGrad2" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#162d4a" />
                <stop offset="100%" stop-color="#122440" />
              </linearGradient>
              <linearGradient id="ropeGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#d4a028" />
                <stop offset="100%" stop-color="#b8860b" />
              </linearGradient>
            </defs>

            <rect width="400" height="300" fill="url(#skyGrad)" />

            <!-- Background building (far) -->
            <rect x="280" y="40" width="90" height="260" fill="#0f1f33" opacity="0.6" />
            <g opacity="0.3">
              <rect x="290" y="55" width="8" height="12" rx="1" fill="#4a90c2" />
              <rect x="305" y="55" width="8" height="12" rx="1" fill="#4a90c2" />
              <rect x="320" y="55" width="8" height="12" rx="1" fill="#3d7aa8" />
              <rect x="290" y="80" width="8" height="12" rx="1" fill="#3d7aa8" />
              <rect x="305" y="80" width="8" height="12" rx="1" fill="#4a90c2" />
              <rect x="320" y="80" width="8" height="12" rx="1" fill="#4a90c2" />
              <rect x="290" y="105" width="8" height="12" rx="1" fill="#4a90c2" />
              <rect x="305" y="105" width="8" height="12" rx="1" fill="#3d7aa8" />
              <rect x="320" y="105" width="8" height="12" rx="1" fill="#4a90c2" />
              <rect x="290" y="130" width="8" height="12" rx="1" fill="#3d7aa8" />
              <rect x="305" y="130" width="8" height="12" rx="1" fill="#4a90c2" />
              <rect x="320" y="130" width="8" height="12" rx="1" fill="#3d7aa8" />
            </g>

            <!-- Main building (facade) -->
            <rect x="60" y="10" width="200" height="290" fill="url(#buildingGrad)" />
            <!-- Building edge highlight -->
            <rect x="60" y="10" width="2" height="290" fill="#2a4f7a" opacity="0.5" />
            <rect x="258" y="10" width="2" height="290" fill="#0f1f33" opacity="0.5" />

            <!-- Floor lines -->
            <line x1="60" y1="70" x2="260" y2="70" stroke="#14253d" stroke-width="1.5" />
            <line x1="60" y1="130" x2="260" y2="130" stroke="#14253d" stroke-width="1.5" />
            <line x1="60" y1="190" x2="260" y2="190" stroke="#14253d" stroke-width="1.5" />
            <line x1="60" y1="250" x2="260" y2="250" stroke="#14253d" stroke-width="1.5" />

            <!-- Windows row 1 -->
            <g class="windows-row">
              <rect x="80" y="25" width="18" height="30" rx="2" fill="#0c1929" stroke="#2a4f7a" stroke-width="0.5" />
              <rect x="110" y="25" width="18" height="30" rx="2" fill="#0c1929" stroke="#2a4f7a" stroke-width="0.5" />
              <rect x="140" y="25" width="18" height="30" rx="2" fill="#1a3352" stroke="#2a4f7a" stroke-width="0.5" />
              <rect x="141" y="26" width="7" height="28" fill="#264a73" opacity="0.3" />
              <rect x="190" y="25" width="18" height="30" rx="2" fill="#0c1929" stroke="#2a4f7a" stroke-width="0.5" />
              <rect x="220" y="25" width="18" height="30" rx="2" fill="#1a3352" stroke="#2a4f7a" stroke-width="0.5" />
              <rect x="221" y="26" width="7" height="28" fill="#264a73" opacity="0.3" />
            </g>

            <!-- Windows row 2 -->
            <g class="windows-row">
              <rect x="80" y="85" width="18" height="30" rx="2" fill="#1a3352" stroke="#2a4f7a" stroke-width="0.5" />
              <rect x="81" y="86" width="7" height="28" fill="#264a73" opacity="0.3" />
              <rect x="110" y="85" width="18" height="30" rx="2" fill="#0c1929" stroke="#2a4f7a" stroke-width="0.5" />
              <rect x="140" y="85" width="18" height="30" rx="2" fill="#0c1929" stroke="#2a4f7a" stroke-width="0.5" />
              <rect x="190" y="85" width="18" height="30" rx="2" fill="#1a3352" stroke="#2a4f7a" stroke-width="0.5" />
              <rect x="191" y="86" width="7" height="28" fill="#264a73" opacity="0.3" />
              <rect x="220" y="85" width="18" height="30" rx="2" fill="#0c1929" stroke="#2a4f7a" stroke-width="0.5" />
            </g>

            <!-- Windows row 3 (worker level) -->
            <g class="windows-row">
              <rect x="80" y="145" width="18" height="30" rx="2" fill="#0c1929" stroke="#2a4f7a" stroke-width="0.5" />
              <rect x="110" y="145" width="18" height="30" rx="2" fill="#1a3352" stroke="#2a4f7a" stroke-width="0.5" />
              <rect x="111" y="146" width="7" height="28" fill="#264a73" opacity="0.3" />
              <rect x="140" y="145" width="18" height="30" rx="2" fill="#0c1929" stroke="#2a4f7a" stroke-width="0.5" />
              <rect x="190" y="145" width="18" height="30" rx="2" fill="#0c1929" stroke="#2a4f7a" stroke-width="0.5" />
              <rect x="220" y="145" width="18" height="30" rx="2" fill="#1a3352" stroke="#2a4f7a" stroke-width="0.5" />
              <rect x="221" y="146" width="7" height="28" fill="#264a73" opacity="0.3" />
            </g>

            <!-- Windows row 4 -->
            <g class="windows-row">
              <rect x="80" y="205" width="18" height="30" rx="2" fill="#1a3352" stroke="#2a4f7a" stroke-width="0.5" />
              <rect x="81" y="206" width="7" height="28" fill="#264a73" opacity="0.3" />
              <rect x="110" y="205" width="18" height="30" rx="2" fill="#0c1929" stroke="#2a4f7a" stroke-width="0.5" />
              <rect x="140" y="205" width="18" height="30" rx="2" fill="#0c1929" stroke="#2a4f7a" stroke-width="0.5" />
              <rect x="190" y="205" width="18" height="30" rx="2" fill="#1a3352" stroke="#2a4f7a" stroke-width="0.5" />
              <rect x="191" y="206" width="7" height="28" fill="#264a73" opacity="0.3" />
              <rect x="220" y="205" width="18" height="30" rx="2" fill="#0c1929" stroke="#2a4f7a" stroke-width="0.5" />
            </g>

            <!-- AC units on facade -->
            <g class="ac-units">
              <rect x="165" y="58" width="20" height="10" rx="2" fill="#3d5a80" stroke="#2a4f7a" stroke-width="0.5" />
              <line x1="168" y1="62" x2="182" y2="62" stroke="#4a7090" stroke-width="0.5" />
              <line x1="168" y1="64" x2="182" y2="64" stroke="#4a7090" stroke-width="0.5" />

              <rect x="165" y="118" width="20" height="10" rx="2" fill="#3d5a80" stroke="#2a4f7a" stroke-width="0.5" />
              <line x1="168" y1="122" x2="182" y2="122" stroke="#4a7090" stroke-width="0.5" />
              <line x1="168" y1="124" x2="182" y2="124" stroke="#4a7090" stroke-width="0.5" />
            </g>

            <!-- AC unit being serviced (glowing) -->
            <g class="ac-service">
              <rect x="165" y="178" width="20" height="10" rx="2" fill="#4a7a9f" stroke="#d4a028" stroke-width="0.8" class="ac-glow" />
              <line x1="168" y1="182" x2="182" y2="182" stroke="#6a9ac0" stroke-width="0.5" />
              <line x1="168" y1="184" x2="182" y2="184" stroke="#6a9ac0" stroke-width="0.5" />
            </g>

            <!-- Rope from rooftop -->
            <line x1="175" y1="0" x2="175" y2="300" stroke="url(#ropeGrad)" stroke-width="1.5" class="rope" />

            <!-- Worker group (descending animation) -->
            <g class="rappel-worker">
              <!-- Safety harness / seat -->
              <rect x="166" y="160" width="18" height="4" rx="1" fill="#8B7355" />

              <!-- Body -->
              <rect x="168" y="136" width="14" height="24" rx="3" fill="#d4a028" />
              <!-- Vest detail -->
              <rect x="169" y="137" width="12" height="8" rx="2" fill="#b8860b" />
              <!-- Reflective stripes -->
              <line x1="170" y1="144" x2="180" y2="144" stroke="#f0d060" stroke-width="1.5" opacity="0.8" />
              <line x1="170" y1="148" x2="180" y2="148" stroke="#f0d060" stroke-width="1.5" opacity="0.6" />

              <!-- Helmet -->
              <ellipse cx="175" cy="130" rx="8" ry="6" fill="#d4a028" />
              <ellipse cx="175" cy="131" rx="7" ry="4.5" fill="#e8b830" />
              <!-- Helmet brim -->
              <rect x="165" y="131" width="20" height="2" rx="1" fill="#d4a028" />

              <!-- Head/face -->
              <circle cx="175" cy="128" r="5" fill="#d4a028" />

              <!-- Left arm (reaching for AC) -->
              <line x1="168" y1="140" x2="160" y2="152" stroke="#d4a028" stroke-width="3" stroke-linecap="round" />
              <!-- Tool in hand -->
              <rect x="155" y="150" width="8" height="3" rx="1" fill="#8B8B8B" class="tool-shine" />

              <!-- Right arm (holding rope) -->
              <line x1="182" y1="140" x2="176" y2="148" stroke="#d4a028" stroke-width="3" stroke-linecap="round" />

              <!-- Legs -->
              <line x1="172" y1="160" x2="168" y2="174" stroke="#1a3352" stroke-width="3" stroke-linecap="round" />
              <line x1="178" y1="160" x2="182" y2="174" stroke="#1a3352" stroke-width="3" stroke-linecap="round" />

              <!-- Boots -->
              <rect x="164" y="172" width="7" height="4" rx="1" fill="#1a1a2e" />
              <rect x="179" y="172" width="7" height="4" rx="1" fill="#1a1a2e" />

              <!-- Carabiner -->
              <circle cx="175" cy="162" r="2.5" fill="none" stroke="#C0C0C0" stroke-width="1" />
              <circle cx="175" cy="162" r="1" fill="#C0C0C0" />

              <!-- Rope connection to harness -->
              <line x1="175" y1="159" x2="175" y2="136" stroke="#b8860b" stroke-width="1" opacity="0.5" />
            </g>

            <!-- Sparkle effects near AC being serviced -->
            <g class="sparkles">
              <circle cx="158" cy="178" r="1.5" fill="#f0d060" class="sparkle-1" />
              <circle cx="153" cy="183" r="1" fill="#f0d060" class="sparkle-2" />
              <circle cx="160" cy="186" r="1.2" fill="#f0d060" class="sparkle-3" />
            </g>

            <!-- Clouds (subtle) -->
            <g opacity="0.06">
              <ellipse cx="40" cy="30" rx="30" ry="10" fill="white" />
              <ellipse cx="340" cy="50" rx="25" ry="8" fill="white" />
            </g>
          </svg>
        </div>
        <div class="absolute -bottom-4 -right-4 w-20 h-20 bg-gold-500/10 rounded-lg -z-10"></div>
      </div>

      <!-- Content -->
      <div class="sr">
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">Climatização no rapel</h2>
        <p class="text-gray-300 leading-relaxed mb-8">
          Instalação, manutenção e higienização de ar-condicionado em fachadas de prédios com acesso por corda. Sem necessidade de andaimes, guindastes ou interdição de áreas — a técnica de rapel industrial permite alcançar qualquer pavimento com agilidade e segurança.
        </p>

        <!-- Advantages grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-10">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 bg-gold-500/[0.12] rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-5 h-5 text-gold-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>
            </div>
            <div>
              <h3 class="font-heading font-semibold text-white text-sm mb-1">Sem andaimes</h3>
              <p class="text-gray-400 text-sm leading-relaxed">Acesso rápido e limpo por corda</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-10 h-10 bg-gold-500/[0.12] rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-5 h-5 text-gold-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
              <h3 class="font-heading font-semibold text-white text-sm mb-1">Sem interdição</h3>
              <p class="text-gray-400 text-sm leading-relaxed">Calçadas e garagens livres</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-10 h-10 bg-gold-500/[0.12] rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-5 h-5 text-gold-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" /></svg>
            </div>
            <div>
              <h3 class="font-heading font-semibold text-white text-sm mb-1">Qualquer altura</h3>
              <p class="text-gray-400 text-sm leading-relaxed">Prédios, torres e fachadas</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-10 h-10 bg-gold-500/[0.12] rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-5 h-5 text-gold-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>
            </div>
            <div>
              <h3 class="font-heading font-semibold text-white text-sm mb-1">Segurança certificada</h3>
              <p class="text-gray-400 text-sm leading-relaxed">Equipe com NR-35</p>
            </div>
          </div>
        </div>

        <!-- WhatsApp CTA -->
        <a
          href="https://wa.me/5521966917054?text=Olá! Gostaria de um orçamento para climatização no rapel."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-3 bg-whatsapp text-white px-8 py-4 rounded-xl text-lg font-semibold hover:brightness-110 transition-all shadow-[0_12px_40px_rgba(37,211,102,0.2)]"
        >
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Solicitar orçamento
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Worker descending animation */
  .rappel-worker {
    animation: descend 6s ease-in-out infinite;
  }

  @keyframes descend {
    0%, 100% {
      transform: translateY(-8px);
    }
    50% {
      transform: translateY(8px);
    }
  }

  /* Subtle body sway */
  .rappel-worker {
    transform-origin: 175px 0px;
    animation: descend 6s ease-in-out infinite, sway 4s ease-in-out infinite;
  }

  @keyframes sway {
    0%, 100% {
      transform: rotate(0deg) translateY(-8px);
    }
    25% {
      transform: rotate(0.8deg) translateY(-2px);
    }
    50% {
      transform: rotate(0deg) translateY(8px);
    }
    75% {
      transform: rotate(-0.8deg) translateY(-2px);
    }
  }

  /* Sparkle effects */
  .sparkle-1 {
    animation: sparkle 2s ease-in-out infinite;
  }
  .sparkle-2 {
    animation: sparkle 2s ease-in-out 0.6s infinite;
  }
  .sparkle-3 {
    animation: sparkle 2s ease-in-out 1.2s infinite;
  }

  @keyframes sparkle {
    0%, 100% {
      opacity: 0;
      transform: scale(0.5);
    }
    50% {
      opacity: 1;
      transform: scale(1.2);
    }
  }

  /* AC unit glow pulse */
  .ac-glow {
    animation: glow-pulse 3s ease-in-out infinite;
  }

  @keyframes glow-pulse {
    0%, 100% {
      filter: drop-shadow(0 0 2px rgba(212, 160, 40, 0.3));
    }
    50% {
      filter: drop-shadow(0 0 6px rgba(212, 160, 40, 0.6));
    }
  }

  /* Tool metallic shine */
  .tool-shine {
    animation: shine 3s ease-in-out infinite;
  }

  @keyframes shine {
    0%, 100% {
      opacity: 0.7;
    }
    50% {
      opacity: 1;
      fill: #b0b0b0;
    }
  }

  /* Rope subtle vibration */
  .rope {
    animation: rope-vibrate 3s ease-in-out infinite;
  }

  @keyframes rope-vibrate {
    0%, 100% {
      stroke-dashoffset: 0;
    }
    50% {
      stroke-dashoffset: 4;
    }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .rappel-worker,
    .sparkle-1, .sparkle-2, .sparkle-3,
    .ac-glow, .tool-shine, .rope {
      animation: none;
    }
  }
</style>
