---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Rappel from "../components/Rappel.astro";
import Brands from "../components/Brands.astro";
import About from "../components/About.astro";
import Differentials from "../components/Differentials.astro";
import Testimonials from "../components/Testimonials.astro";
import Gallery from "../components/Gallery.astro";
import FAQ from "../components/FAQ.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

const whatsappBase = "https://wa.me/5521966917054";
const whatsappMsg = encodeURIComponent("Olá! Tenho interesse em um contrato de manutenção de ar condicionado para minha empresa. Gostaria de saber mais.");
const whatsappLink = `${whatsappBase}?text=${whatsappMsg}`;

const services = [
