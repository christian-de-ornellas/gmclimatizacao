    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>',
    title: "Infraestrutura e retrofit",
    description: "Modernização de sistemas antigos e adequação de infraestrutura. Tubulação, dreno, elétrica e automação dimensionados para a demanda real da sua operação.",
  },
];

const testimonials = [
  {
    name: "Ana Paula Soares",
    text: "Gerencio uma clínica com 14 aparelhos. A GM assumiu o PMOC e a manutenção preventiva trimestral. Em oito meses, nenhuma parada não programada. Antes, era uma dor de cabeça por mês.",
    rating: 5,
  },
  {
    name: "Roberto Lima",
    text: "Precisei trocar todo o sistema VRF do escritório em plena operação. A equipe trabalhou em horário alternativo para não parar nossas atividades. Entregaram no prazo combinado, sem um dia de atraso.",
    rating: 5,
  },
  {
    name: "Pedro Henrique Castro",
    text: "Climatizaram meu escritório de 120m² com multi split. A conta de luz ficou 30% menor que o sistema antigo de janela. O projeto se pagou em poucos meses.",
    rating: 5,
  },
];

const projects = [
  { title: "Andar Corporativo — Centro", gradient: "from-navy-900 to-navy-700" },
  { title: "Clínica — Botafogo", gradient: "from-navy-700 to-navy-500" },
  { title: "Loja Shopping — Barra", gradient: "from-navy-500 to-gold-600" },
  { title: "Restaurante — Leblon", gradient: "from-navy-700 to-navy-900" },
  { title: "Coworking — Flamengo", gradient: "from-gold-600 to-navy-700" },
  { title: "Escritório Advocacia — Centro", gradient: "from-navy-900 to-navy-500" },
];

const faqs = [
  {
    question: "O que é PMOC e minha empresa precisa ter?",
    answer: "PMOC é o Plano de Manutenção, Operação e Controle, exigido por lei (Portaria 3.523/98 e Resolução ANVISA RE-09) para ambientes com sistemas de climatização acima de 5 TR. Sem ele, sua empresa está sujeita a multas, interdições e processos sanitários.",
  },
  {
    question: "Qual a frequência ideal de manutenção preventiva?",
    answer: "Para ambientes comerciais com uso intenso, a cada 3 meses. Para ambientes com menor circulação, a cada 4 meses. Definimos o cronograma ideal na consultoria inicial, considerando o uso e a quantidade de equipamentos.",
  },
  {
    question: "Vocês atendem fora do horário comercial?",
    answer: "Sim. Para contratos de manutenção, atendemos em horários alternativos — incluindo noites e finais de semana — para não impactar a operação da sua empresa.",
  },
  {
    question: "Como funciona o contrato de manutenção?",
    answer: "Fazemos um diagnóstico inicial, definimos o escopo e a frequência das visitas, e formalizamos com contrato. Você recebe um cronograma anual com datas pré-agendadas e relatórios técnicos após cada visita.",
  },
  {
    question: "Qual o tempo de resposta para emergências?",
    answer: "Para clientes com contrato ativo, o primeiro atendimento acontece em até 24 horas. Em situações críticas, priorizamos o chamado e alocamos a equipe mais próxima disponível.",
  },
  {
    question: "Vocês emitem relatório técnico das visitas?",
    answer: "Sim. Cada visita gera um relatório detalhado com fotos, medições, diagnóstico e recomendações. Tudo documentado para conformidade e controle do gestor responsável.",
  },
];

const differentials = [
  {
    icon: '<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" /></svg>',
    title: "Técnicos certificados",
    description: "Equipe com certificação direta de Daikin, LG, Samsung e Carrier. Treinamento exclusivo e domínio técnico que garante diagnósticos precisos.",
  },
  {
    icon: '<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>',
    title: "SLA de atendimento",
    description: "Tempo de resposta definido em contrato. Para emergências, primeiro atendimento em até 24 horas com prioridade de alocação de equipe.",
  },
  {
    icon: '<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>',
    title: "Conformidade total",
    description: "PMOC documentado, laudos técnicos, relatórios com fotos e medições. Tudo que a ANVISA e a vigilância sanitária exigem, entregue com rigor.",
  },
  {
    icon: '<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" /></svg>',
    title: "Custo previsível",
    description: "Contrato com valor fixo mensal. Sem surpresas no orçamento — você sabe exatamente quanto vai investir em manutenção durante o ano.",
  },
  {
    icon: '<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3H21m-3.75 3H21" /></svg>',
    title: "Qualquer escala",
    description: "De uma sala comercial a um edifício inteiro. A mesma exigência técnica e o mesmo padrão de atendimento em qualquer tamanho de projeto.",
  },
  {
    icon: '<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>',
    title: "Gestor técnico dedicado",
    description: "Um ponto focal que conhece seu parque de equipamentos, histórico de manutenções e particularidades da sua operação. Comunicação direta e sem intermediários.",
  },
