import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

const whatsappBase = "https://wa.me/5521966917054";
const whatsappMsg = encodeURIComponent("Olá! Tenho interesse em climatização para meu apartamento. Gostaria de solicitar um orçamento.");
const whatsappLink = `${whatsappBase}?text=${whatsappMsg}`;

